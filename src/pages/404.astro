---
import Layout from "../layouts/Layout.astro";

const BG = "#0E0E0E";
const FG = "#FFFFFF";
const MUTED = "rgba(255,255,255,.58)";
const FAINT = "rgba(255,255,255,.34)";
const LINE = "rgba(255,255,255,.1)";
const ACCENT = "#554070";
---

<Layout title="404 — Francisco Espindola" description="Page not found.">
  <div class="root" style={`background:${BG}; color:${FG}; min-height:100vh; font-family:'Inter',sans-serif;`}>
    <div class="dot-grid" aria-hidden="true"></div>

    <div class="wrap">
      <span class="corner corner-tl" aria-hidden="true">+</span>
      <span class="corner corner-tr" aria-hidden="true">+</span>
      <span class="corner corner-bl" aria-hidden="true">+</span>
      <span class="corner corner-br" aria-hidden="true">+</span>

      <span class="code">404</span>
      <h1 class="title" data-i18n="title">Page not found.</h1>
      <p class="desc" data-i18n="desc">This page doesn't exist, moved, or never did. Let's get you back.</p>
      <a href="/" class="back-link"><span aria-hidden="true">←</span> <span data-i18n="back">Back to portfolio</span></a>
    </div>
  </div>
</Layout>

<script>
  const ES = {
    title: 'Página no encontrada.',
    desc: 'Esta página no existe, se movió o nunca existió. Volvamos al inicio.',
    back: 'Volver al portfolio',
  };

  const LANG_KEY = 'site-lang';
  let storedLang = 'en';
  try { storedLang = localStorage.getItem(LANG_KEY) || 'en'; } catch {}

  if (storedLang === 'es') {
    document.documentElement.lang = 'es';
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (ES[key]) el.textContent = ES[key];
    });
  }
</script>

<style define:vars={{ accent: ACCENT, muted: MUTED, faint: FAINT, line: LINE }}>
  .root { --accent: var(--accent); position: relative; overflow: hidden; display: flex; align-items: center; }

  .dot-grid {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,.09) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 18px 18px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 40%, transparent 92%);
  }

  .corner { position: absolute; z-index: 2; color: var(--faint); font-size: 12px; line-height: 1; font-family: 'JetBrains Mono', monospace; pointer-events: none; }
  .corner-tl { top: 16px; left: 16px; }
  .corner-tr { top: 16px; right: 16px; }
  .corner-bl { bottom: 16px; left: 16px; }
  .corner-br { bottom: 16px; right: 16px; }

  .wrap {
    position: relative; z-index: 1;
    max-width: 480px;
    margin: 0 auto;
    padding: 24px;
    text-align: center;
  }

  .code {
    display: block; font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 20px;
  }
  .title { font-size: clamp(28px, 6vw, 40px); font-weight: 700; letter-spacing: -.02em; margin-bottom: 14px; }
  .desc { font-size: 15px; line-height: 1.7; color: var(--muted); margin-bottom: 32px; }

  .back-link {
    display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px;
    letter-spacing: .06em; text-transform: uppercase; color: #fff; text-decoration: none;
    border: 1px solid var(--line); padding: 12px 20px; transition: border-color .2s ease;
  }
  .back-link:hover { border-color: var(--accent); }
</style>
