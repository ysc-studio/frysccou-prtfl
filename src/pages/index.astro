<style>
  .hover-fg:hover { color: var(--fg); }
  .hover-bright:hover { color: var(--on-acc); filter: brightness(1.08); }
  .hover-acc-border:hover { border-color: var(--acc); }
  .hover-line:hover { background: color-mix(in oklab, var(--acc) 7%, transparent); }

  .pan-shot { object-position: center top; animation: pan-shot 11s ease-in-out infinite alternate; }
  @keyframes pan-shot { from { object-position: center top; } to { object-position: center bottom; } }
</style>

<script>
  const WORDS = {
    en: ['interfaces', 'APIs', 'desktop apps', 'real-time systems', 'architecture'],
    es: ['interfaces', 'APIs', 'apps de escritorio', 'sistemas en tiempo real', 'arquitectura'],
  };
  const JOKES = {
    en: [
      "Why would you want me to code a light theme? Real devs work in the dark.",
      "Error 418: I'm a teapot, not a flashlight. Are you really sure?",
      'Fine, you win. Deploying light mode… bring sunglasses.',
    ],
    es: [
      '¿Para qué querés que codifique un tema claro? Los devs de verdad programamos a oscuras.',
      'Error 418: soy una tetera, no una linterna. ¿Seguro seguro?',
      'Bueno, vos ganás. Deployando tema claro… traé lentes de sol.',
    ],
  };
  const THEME_KEY = 'ysc-theme', LANG_KEY = 'ysc-lang', MOTION_KEY = 'ysc-motion';

  const root = document.documentElement;
  let theme = localStorage.getItem(THEME_KEY) || 'dark';
  let lang = localStorage.getItem(LANG_KEY) || 'en';
  let motion = localStorage.getItem(MOTION_KEY) ? localStorage.getItem(MOTION_KEY) === 'on' : !matchMedia('(prefers-reduced-motion: reduce)').matches;
  let jokes = 0;

  function apply() {
    root.dataset.theme = theme; root.dataset.lang = lang; root.dataset.motion = motion ? 'on' : 'off'; root.lang = lang;
    try { localStorage.setItem(THEME_KEY, theme); localStorage.setItem(LANG_KEY, lang); localStorage.setItem(MOTION_KEY, motion ? 'on' : 'off'); } catch (e) {}
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) themeBtn.textContent = theme === 'dark' ? '◐ dark' : '◑ light';
    const motionBtn = document.getElementById('motion-toggle');
    if (motionBtn) motionBtn.textContent = motion ? '❚❚ motion' : '▶ motion';
    const enBtn = document.getElementById('lang-en-btn'), esBtn = document.getElementById('lang-es-btn');
    if (enBtn) { enBtn.style.background = lang === 'en' ? 'var(--fg)' : 'transparent'; enBtn.style.color = lang === 'en' ? 'var(--bg)' : 'var(--mute)'; }
    if (esBtn) { esBtn.style.background = lang === 'es' ? 'var(--fg)' : 'transparent'; esBtn.style.color = lang === 'es' ? 'var(--bg)' : 'var(--mute)'; }
  }
  apply();

  document.getElementById('lang-en-btn')?.addEventListener('click', () => { lang = 'en'; apply(); wi = 0; scramble(WORDS.en[0]); });
  document.getElementById('lang-es-btn')?.addEventListener('click', () => { lang = 'es'; apply(); wi = 0; scramble(WORDS.es[0]); });

  let toastTimer: ReturnType<typeof setTimeout> | undefined;
  function showToast(n: number) {
    clearTimeout(toastTimer);
    const toast = document.getElementById('toast');
    const tag = document.getElementById('toast-tag');
    const msg = document.getElementById('toast-msg');
    const hint = document.getElementById('toast-hint');
    if (!toast || !tag || !msg || !hint) return;
    const j = JOKES[lang as 'en' | 'es'];
    msg.textContent = j[n - 1];
    tag.textContent = `easter egg · ${n}/3`;
    const left = 3 - n;
    hint.textContent = n === 3
      ? (lang === 'es' ? '// easter egg desbloqueado' : '// easter egg unlocked')
      : (lang === 'es' ? `// psst: es un easter egg — tocá ${left} vez${left > 1 ? 'es' : ''} más` : `// psst: it's an easter egg — click ${left} more time${left > 1 ? 's' : ''}`);
    toast.style.opacity = '1';
    toast.style.transform = 'translate(-50%,0)';
    toastTimer = setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translate(-50%,16px)'; }, n === 3 ? 3200 : 4500);
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    if (theme === 'dark') {
      jokes++;
      showToast(jokes);
      if (jokes < 3) return;
      jokes = 0;
    }
    theme = theme === 'dark' ? 'light' : 'dark';
    apply();
  });
  document.getElementById('motion-toggle')?.addEventListener('click', () => { motion = !motion; apply(); });

  // CLOCK + UPTIME
  const START = new Date('2024-08-01T09:00:00-03:00').getTime();
  function clock() {
    const now = new Date();
    const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' }).format(now);
    const timeEl = document.getElementById('clock-time');
    if (timeEl) timeEl.textContent = time;
    const s = Math.floor((now.getTime() - START) / 1000), d = Math.floor(s / 86400);
    const y = Math.floor(d / 365.25), m = Math.floor((d - y * 365.25) / 30.44), dd = Math.floor(d - y * 365.25 - m * 30.44);
    const p = (n: number) => String(n).padStart(2, '0'), r = s % 86400;
    const upEl = document.getElementById('uptime');
    if (upEl) upEl.textContent = `${y}y ${p(m)}m ${p(dd)}d ${p(Math.floor(r / 3600))}:${p(Math.floor((r % 3600) / 60))}:${p(r % 60)}`;
  }
  clock(); setInterval(clock, 1000);

  // SCRAMBLE WORD
  let wi = 0, scrT: ReturnType<typeof setInterval> | undefined;
  function scramble(to: string) {
    const el = document.getElementById('scramble-word'); if (!el) return;
    const chars = '<>/{}[]=+*#01_$', total = 16; let f = 0;
    clearInterval(scrT);
    scrT = setInterval(() => {
      f++; let out = '';
      for (let i = 0; i < to.length; i++) out += (f / total) * to.length > i || to[i] === ' ' ? to[i] : chars[Math.floor(Math.random() * chars.length)];
      el.textContent = out;
      if (f >= total) { el.textContent = to; clearInterval(scrT); }
    }, 38);
  }
  scramble(WORDS[lang as 'en' | 'es'][0]);
  setInterval(() => { if (!motion) return; const w = WORDS[lang as 'en' | 'es']; wi = (wi + 1) % w.length; scramble(w[wi]); }, 2600);

  // REVEAL ON SCROLL
  (function reveal() {
    const els = document.querySelectorAll('[data-reveal]');
    const io = new IntersectionObserver((es) => es.forEach((en) => {
      if (en.isIntersecting) { (en.target as HTMLElement).style.opacity = '1'; (en.target as HTMLElement).style.transform = 'none'; io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => {
      const r = el.getBoundingClientRect(); if (r.top < innerHeight) return;
      (el as HTMLElement).style.opacity = '0'; (el as HTMLElement).style.transform = 'translateY(24px)';
      (el as HTMLElement).style.transition = 'opacity .8s ease, transform .9s cubic-bezier(.2,.7,.2,1)';
      io.observe(el);
    });
  })();

  // CANVAS PARTICLE GRID
  (function particles() {
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d'); if (!ctx) return;
    let cw = 0, ch = 0, dpr = 1, drawn = false;
    const mouse = { x: -9999, y: -9999 };
    let colors = { fg: '#eceee8', acc: 'oklch(0.88 0.19 125)' };
    function readColors() {
      requestAnimationFrame(() => {
        const cs = getComputedStyle(root);
        colors = { fg: cs.getPropertyValue('--fg').trim(), acc: cs.getPropertyValue('--acc').trim() };
      });
    }
    readColors();
    const themeObserver = new MutationObserver(() => { readColors(); drawn = false; });
    themeObserver.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    function resize() {
      const parent = canvas.parentElement; if (!parent) return;
      dpr = Math.min(devicePixelRatio || 1, 2);
      cw = parent.clientWidth; ch = parent.clientHeight;
      canvas.width = cw * dpr; canvas.height = ch * dpr; drawn = false;
    }
    new ResizeObserver(resize).observe(canvas.parentElement!);
    resize();
    window.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    function frame(now: number) {
      requestAnimationFrame(frame);
      if (!motion && drawn) return;
      const t = motion ? now / 1000 : 0, gap = 22, { x: mx, y: my } = mouse;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0); ctx!.clearRect(0, 0, cw, ch);
      for (let x = gap / 2; x < cw; x += gap) for (let y = gap / 2; y < ch; y += gap) {
        const d = Math.hypot(x - mx, y - my), k = Math.max(0, 1 - d / 170);
        const wave = (Math.sin(x * 0.011 + t * 0.9) + Math.sin(y * 0.016 - t * 0.7) + 2) / 4;
        const s = 1.6 + k * 2.4 + wave * 0.6;
        ctx!.globalAlpha = Math.min(1, 0.07 + wave * 0.12 + k * 0.85);
        ctx!.fillStyle = k > 0.04 ? colors.acc : colors.fg;
        ctx!.fillRect(x - s / 2, y - s / 2, s, s);
      }
      ctx!.globalAlpha = 1; drawn = true;
    }
    requestAnimationFrame(frame);
  })();

  // WORK SHOWCASE — sidebar picks + autoplay progress + hover pause
  (function workShowcase() {
    const showcase = document.getElementById('work-showcase'); if (!showcase) return;
    const rows = Array.from(showcase.querySelectorAll('[data-work-pick]')) as HTMLElement[];
    const articles = Array.from(showcase.querySelectorAll('[data-work-article]')) as HTMLElement[];
    const progress = document.getElementById('work-progress');
    const total = rows.length;
    let active = 0, hover = false, swStart = performance.now(), swPaused = 0;

    function setActive(i: number) {
      active = i;
      rows.forEach((row, ri) => {
        row.style.background = ri === active ? 'var(--card)' : 'transparent';
        const num = row.querySelector('[data-work-num]') as HTMLElement | null;
        if (num) num.style.color = ri === active ? 'var(--acc)' : 'var(--mute)';
      });
      articles.forEach((art, ai) => {
        art.style.opacity = ai === active ? '1' : '0';
        art.style.transform = ai === active ? 'none' : `translateY(${ai < active ? -14 : 14}px)`;
        art.style.pointerEvents = ai === active ? 'auto' : 'none';
      });
    }
    setActive(0);

    rows.forEach((row, i) => row.addEventListener('click', () => { swStart = performance.now(); swPaused = 0; setActive(i); }));
    showcase.addEventListener('mouseenter', () => { hover = true; });
    showcase.addEventListener('mouseleave', () => { hover = false; });

    function frame(now: number) {
      requestAnimationFrame(frame);
      if (!progress) return;
      if (!motion || hover) swStart = now - swPaused;
      const el = now - swStart; swPaused = el;
      const p = Math.min(1, el / 6500);
      progress.style.width = (p * 100) + '%';
      if (p >= 1) { swStart = now; swPaused = 0; setActive((active + 1) % total); }
    }
    requestAnimationFrame(frame);
  })();

  // ZATOBOX MEDIA — tiny manual-only carousel (screenshot / video), independent from the autoplay system
  (function zatoboxMedia() {
    const media = document.getElementById('zatobox-media'); if (!media) return;
    const slides = Array.from(media.querySelectorAll('[data-zb-slide]')) as HTMLElement[];
    const dots = Array.from(media.querySelectorAll('[data-zb-dot]')) as HTMLElement[];
    function go(i: number) {
      slides.forEach((s, si) => {
        s.style.opacity = si === i ? '1' : '0';
        s.style.pointerEvents = si === i ? 'auto' : 'none';
        if (si !== i) s.querySelector('video')?.pause();
      });
      dots.forEach((d, di) => {
        d.style.background = di === i ? 'oklch(0.88 0.19 125)' : 'transparent';
        d.style.color = di === i ? '#eceee8' : '#8b8f87';
      });
    }
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
  })();

  // MORE-WORK CAROUSELS — shared tick, per-carousel manual override
  (function carousels() {
    const nodes = Array.from(document.querySelectorAll('[data-carousel]')) as HTMLElement[];
    const picks: Record<string, number> = {};
    let tick = 0;

    function render() {
      nodes.forEach((node, ci) => {
        const key = node.getAttribute('data-carousel')!;
        const cur = picks[key] ?? ((tick + ci) % 3);
        const slides = Array.from(node.querySelectorAll('.carousel-slide')) as HTMLElement[];
        const dots = Array.from(node.querySelectorAll('.carousel-dot')) as HTMLElement[];
        const badge = node.querySelector('.carousel-badge');
        slides.forEach((s, i) => {
          s.style.opacity = i === cur ? '1' : '0';
          s.style.transform = i === cur ? 'scale(1)' : 'scale(1.04)';
          s.style.pointerEvents = i === cur ? 'auto' : 'none';
        });
        dots.forEach((dot, i) => {
          dot.style.width = i === cur ? '18px' : '5px';
          dot.style.background = i === cur ? 'var(--acc)' : 'var(--line)';
        });
        if (badge) badge.textContent = `${cur + 1}/3`;
      });
    }
    render();

    nodes.forEach((node) => {
      const key = node.getAttribute('data-carousel')!;
      const dots = Array.from(node.querySelectorAll('.carousel-dot')) as HTMLElement[];
      dots.forEach((dot, i) => dot.addEventListener('click', () => { picks[key] = i; render(); }));
    });

    setInterval(() => { if (!motion) return; tick++; render(); }, 3600);
  })();
</script>
