        <a href="https://www.linkedin.com/in/espindola-francisco" target="_blank" style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:18px 0;border-bottom:1px solid var(--line);text-decoration:none"><span style="display:flex;flex-direction:column;gap:4px"><span style="font-size:17px;font-weight:500">LinkedIn</span><span style="font-family:'Martian Mono',monospace;font-size:11px;color:var(--mute)">espindola-francisco</span></span><span>↗</span></a>
