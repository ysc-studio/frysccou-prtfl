---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import profile from "../assets/profile.jpg";

import tiklivetts from "../assets/projects/tiklivetts.png";
import tokenit from "../assets/projects/tokenit.png";
import tokenitApp from "../assets/projects/app-tokenit.png";
import zatobox from "../assets/projects/zatobox.png";
import zatoboxVideo from "../assets/projects/zatobox.mp4";
import consentido from "../assets/projects/consentido.png";

import elevate from "../assets/sideprojects/elevate.png";
import atlas from "../assets/sideprojects/atlas.png";
import aurora from "../assets/sideprojects/aurora.png";
import coffee from "../assets/sideprojects/coffee.png";

import arc1 from "../assets/projects/Arc/1.png";
import arc2 from "../assets/projects/Arc/2.png";
import arc3 from "../assets/projects/Arc/3.png";
import outdoor1 from "../assets/projects/outdoor/1.png";
import outdoor2 from "../assets/projects/outdoor/2.png";
import outdoor3 from "../assets/projects/outdoor/3.png";
import muebles1 from "../assets/projects/muebles/1.png";
import muebles2 from "../assets/projects/muebles/2.png";
import muebles3 from "../assets/projects/muebles/3.png";
import prisma1 from "../assets/projects/prisma/1.png";
import prisma2 from "../assets/projects/prisma/2.png";
import prisma3 from "../assets/projects/prisma/3.png";

const PROJECTS = [
  {
    num: "01", title: "TikLiveTTS", stackShort: "Electron · WebSocket", badge: true,
    img: tiklivetts, alt: "TikLiveTTS — app screenshot",
    catEn: "Desktop App · Live Streaming Tools", catEs: "App de Escritorio · Herramientas para Streaming",
    descEn: "Open-source Electron desktop app that reads TikTok Live, Twitch, YouTube and Kick chat aloud while streaming, with OBS-ready overlays, moderation tools and Polar-powered subscriptions.",
    descEs: "App de escritorio open-source hecha con Electron que lee en voz alta el chat de TikTok Live, Twitch, YouTube y Kick mientras transmitís, con overlays para OBS, moderación y suscripciones gestionadas con Polar.",
    stack: ["Electron", "Express", "WebSocket", "Polar"], url: "https://www.tiklivetts.es/", domain: "tiklivetts.es",
  },
  {
    num: "02", title: "Tokenit — Investor App", stackShort: "Meteor.js · Web3",
    img: tokenitApp, alt: "Tokenit — investor app",
    catEn: "Investor App · Web3", catEs: "App de Inversores · Web3",
    descEn: "Investor dashboard for a Chilean blockchain real-estate platform — real-time monitoring, KYC, digital signing and AI risk scoring.",
    descEs: "Panel de inversores para una plataforma chilena de real estate en blockchain — monitoreo en tiempo real, KYC, firma digital y scoring de riesgo con IA.",
    stack: ["Meteor.js", "React", "Web3"], url: "https://app.tokenit.cl", domain: "app.tokenit.cl",
  },
  {
    num: "03", title: "Tokenit — Landing Page", stackShort: "Gatsby · Python",
    img: tokenit, alt: "Tokenit — landing page",
    catEn: "Landing Page · Web3", catEs: "Landing Page · Web3",
    descEn: "Public marketplace connecting investors with tokenized real-estate opportunities backed by real assets.",
    descEs: "Marketplace público que conecta inversores con oportunidades de real estate tokenizado respaldadas por activos reales.",
    stack: ["Gatsby", "Python", "MongoDB"], url: "https://tokenit.cl", domain: "tokenit.cl",
  },
  {
    num: "04", title: "ZatoBox", stackShort: "Next.js · Docker", archived: true,
    img: zatobox, alt: "ZatoBox — video still",
    catEn: "Open Source · POS", catEs: "Open Source · POS",
    descEn: "Open-source point-of-sale system with real-time inventory, order management and a Docker-based deployment pipeline.",
    descEs: "Sistema de punto de venta open-source con inventario en tiempo real, gestión de pedidos y un pipeline de despliegue basado en Docker.",
    memorialEn: "The site is no longer live. This video shows ZatoBox back when it was up and running.",
    memorialEs: "El sitio ya no está en línea. Este video muestra ZatoBox cuando estaba en vivo.",
    stack: ["Next.js", "Supabase", "Docker"],
  },
  {
    num: "05", title: "ConSentido Cognitivo", stackShort: "Next.js · Firebase",
    img: consentido, alt: "ConSentido Cognitivo — platform",
    catEn: "Psicopedagogía · Accessibility", catEs: "Psicopedagogía · Accesibilidad",
    descEn: "Accessible platform for a psychopedagogy practice, built to make cognitive-support resources easy to reach for families.",
    descEs: "Plataforma accesible para un consultorio de psicopedagogía, pensada para que las familias accedan fácilmente a recursos de apoyo cognitivo.",
    stack: ["Next.js", "Tailwind", "Firebase"], url: "https://www.consentidocognitivo.site/", domain: "consentidocognitivo.site",
  },
];

const MORE_WORK_FULL = [
  { id: "elevate", title: "Elevate Gym", num: "06", img: elevate },
  { id: "atlas", title: "Atlas", num: "07", img: atlas },
  { id: "aurora", title: "Aurora AI", num: "08", img: aurora },
  { id: "noma", title: "Noma Coffee", num: "09", img: coffee },
];

const MORE_WORK_CAROUSEL = [
  { key: "arc", title: "Arc & Form", imgs: [arc1, arc2, arc3] },
  { key: "wildoak", title: "Wild Oak Supply", imgs: [outdoor1, outdoor2, outdoor3] },
  { key: "muebles", title: "Muebles & Decoración", imgs: [muebles1, muebles2, muebles3] },
  { key: "prisma", title: "Prisma Events", imgs: [prisma1, prisma2, prisma3] },
];

const WHATSAPP_URL_EN = "https://wa.me/5491167672197?text=Hi%20Francisco!%20I%20found%20your%20portfolio%20and%20I'd%20like%20to%20talk%20about%20a%20project.";
const WHATSAPP_URL_ES = "https://wa.me/5491167672197?text=%C2%A1Hola%20Francisco!%20Vi%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto.";
const EMAIL_URL_EN = "mailto:franespindola71@gmail.com?subject=Let's%20talk%20about%20a%20project";
const EMAIL_URL_ES = "mailto:franespindola71@gmail.com?subject=Hablemos%20sobre%20un%20proyecto";
---

<Layout>
<div style="min-height:100vh;background:var(--bg);color:var(--fg);transition:background .35s,color .35s;overflow-x:clip">

  <header style="position:sticky;top:0;z-index:30;background:color-mix(in oklab,var(--bg) 78%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)">
    <div style="max-width:1200px;margin:0 auto;padding:12px clamp(18px,4vw,40px);display:flex;align-items:center;justify-content:space-between;gap:14px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.02em">
      <a href="#top" style="display:flex;align-items:center;gap:6px;text-decoration:none;color:var(--fg);text-transform:none;font-size:13px;font-weight:500">
        <span style="color:var(--acc)">ysc</span><span style="color:var(--mute)">/</span><span>studio</span><span style="width:8px;height:15px;background:var(--acc);animation:blink 1.1s step-end infinite"></span>
      </a>
      <nav style="display:flex;align-items:center;gap:clamp(10px,2.4vw,24px);flex-wrap:wrap;justify-content:flex-end">
        <a href="#work" style="text-decoration:none;color:var(--mute)">./<span data-en="">work</span><span data-es="">proyectos</span></a>
        <a href="#log" style="text-decoration:none;color:var(--mute)">./log</a>
        <a href="#contact" style="text-decoration:none;color:var(--mute)">./<span data-en="">contact</span><span data-es="">contacto</span></a>
        <div style="display:flex;align-items:center;border:1px solid var(--line);border-radius:6px;overflow:hidden">
          <button id="lang-en-btn" type="button" style="all:unset;cursor:pointer;padding:6px 9px">EN</button>
          <button id="lang-es-btn" type="button" style="all:unset;cursor:pointer;padding:6px 9px">ES</button>
        </div>
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="hover-fg" style="all:unset;cursor:pointer;padding:6px 9px;border:1px solid var(--line);border-radius:6px;color:var(--mute)">◐ dark</button>
        <button id="motion-toggle" type="button" aria-label="Toggle motion" class="hover-fg" style="all:unset;cursor:pointer;padding:6px 9px;border:1px solid var(--line);border-radius:6px;color:var(--mute)">❚❚ motion</button>
      </nav>
    </div>
  </header>

  <section id="top" style="position:relative;min-height:calc(100vh - 56px);display:flex;align-items:center">
    <div style="position:absolute;inset:0;pointer-events:none;-webkit-mask-image:radial-gradient(ellipse 80% 75% at 60% 40%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 80% 75% at 60% 40%,#000 30%,transparent 80%)">
      <canvas id="particle-canvas" style="width:100%;height:100%;display:block"></canvas>
    </div>
    <div style="position:relative;width:100%;max-width:1200px;margin:0 auto;padding:clamp(40px,8vw,96px) clamp(18px,4vw,40px);display:flex;flex-direction:column;gap:clamp(28px,4vw,44px)">
      <div style="display:flex;flex-wrap:wrap;gap:8px 22px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.02em;color:var(--mute)">
        <span style="display:flex;align-items:center;gap:8px;color:var(--acc)"><span style="width:7px;height:7px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 4px color-mix(in oklab,var(--acc) 22%,transparent);animation:pulse 2s ease-in-out infinite"></span><span data-en="">online · open to projects</span><span data-es="">online · abierto a proyectos</span></span>
        <span>Buenos Aires · <span id="clock-time">--:--</span> GMT-3</span>
        <span>uptime <span id="uptime" style="color:var(--fg)"></span></span>
      </div>

      <h1 style="margin:0;font-family:'Doto',monospace;font-weight:900;font-size:clamp(46px,11.5vw,168px);line-height:.88;letter-spacing:-.02em;text-transform:uppercase">Francisco<br>Espindola</h1>

      <p style="margin:0;font-size:clamp(22px,3vw,38px);line-height:1.15;font-weight:400;letter-spacing:-.015em;max-width:24ch">
        <span>Full Stack Engineer.</span><br>
        <span style="color:var(--mute)"><span data-en="">I build</span><span data-es="">Construyo</span> </span><span id="scramble-word" style="color:var(--acc);font-weight:600"></span><span style="display:inline-block;width:.45em;height:.9em;margin-left:4px;vertical-align:-.08em;background:var(--acc);animation:blink 1.1s step-end infinite"></span>
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px;align-items:end">
        <div style="border:1px solid var(--line);border-radius:14px;background:color-mix(in oklab,var(--card) 88%,transparent);backdrop-filter:blur(6px);overflow:hidden">
          <div style="display:flex;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--line);font-family:'Martian Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--mute)"><span>~/francisco — zsh</span><span>bio.md</span></div>
          <div style="padding:18px 18px 20px;display:flex;flex-direction:column;gap:14px;font-size:16px;line-height:1.6;text-wrap:pretty">
            <div style="display:flex;align-items:center;gap:12px;font-family:'Martian Mono',monospace;font-size:12px"><span style="color:var(--acc)">$</span><span>whoami</span></div>
            <div style="display:flex;gap:14px;align-items:flex-start">
              <div style="width:52px;height:52px;flex:none;border-radius:50%;overflow:hidden">
                <Image src={profile} alt="Francisco Espindola" width={104} height={104} style="width:100%;height:100%;object-fit:cover;display:block" />
              </div>
              <div data-en="" style="display:flex;flex-direction:column;gap:10px">
                <p style="margin:0">I'm a Full Stack Engineer based in Buenos Aires, Argentina, building digital products end to end — from interface to architecture.</p>
                <p style="margin:0;color:var(--mute)">I care deeply about craft and clean code, and I like turning ideas into things people actually enjoy using. I also make content on <a href="https://www.youtube.com/@fryscoo" target="_blank">YouTube</a> and <a href="https://instagram.com/fryscco_" target="_blank">Instagram</a>. Reach me on <a href="https://www.linkedin.com/in/espindola-francisco" target="_blank">LinkedIn</a> or <a href="mailto:franespindola71@gmail.com">email</a>, see my code on <a href="https://github.com/esspindola" target="_blank">GitHub</a>.</p>
              </div>
              <div data-es="" style="display:flex;flex-direction:column;gap:10px">
                <p style="margin:0">Soy Full Stack Engineer con base en Buenos Aires, Argentina, construyendo productos digitales de punta a punta — desde la interfaz hasta la arquitectura.</p>
                <p style="margin:0;color:var(--mute)">Me importa profundamente el cuidado del detalle y el código limpio, y me gusta convertir ideas en cosas que la gente realmente disfrute usar. También hago contenido en <a href="https://www.youtube.com/@fryscoo" target="_blank">YouTube</a> e <a href="https://instagram.com/fryscco_" target="_blank">Instagram</a>. Contáctame por <a href="https://www.linkedin.com/in/espindola-francisco" target="_blank">LinkedIn</a> o <a href="mailto:franespindola71@gmail.com">correo</a>, y mirá mi código en <a href="https://github.com/esspindola" target="_blank">GitHub</a>.</p>
              </div>
            </div>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-start">
          <a href="#work" class="hover-bright" style="display:inline-flex;align-items:center;gap:10px;padding:15px 22px;border-radius:10px;background:var(--acc);color:var(--on-acc);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;text-transform:uppercase"><span data-en="">See the work</span><span data-es="">Ver proyectos</span> ↓</a>
          <a href="#contact" style="display:inline-flex;align-items:center;gap:10px;padding:15px 22px;border-radius:10px;border:1px solid var(--line);background:var(--bg);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;text-transform:uppercase"><span data-en="">Let's talk</span><span data-es="">Hablemos</span> →</a>
        </div>
      </div>
    </div>
  </section>

  <main style="max-width:1200px;margin:0 auto;padding:0 clamp(18px,4vw,40px)">

    <section id="work" style="padding:clamp(72px,10vw,128px) 0">
      <div data-reveal="" style="display:flex;align-items:center;gap:14px;margin-bottom:20px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--mute)"><span style="color:var(--acc)">01</span><span><span data-en="">Selected work</span><span data-es="">Proyectos</span></span><span style="flex:1;height:1px;background:var(--line)"></span><span>~/work</span></div>
      <h2 data-reveal="" style="margin:0 0 clamp(32px,5vw,56px);font-size:clamp(36px,5.6vw,76px);line-height:1;font-weight:600;letter-spacing:-.035em"><span data-en="">Things I've shipped.</span><span data-es="">Cosas que lancé.</span></h2>

      <div id="work-showcase" style="display:flex;flex-wrap:wrap;gap:28px;align-items:flex-start">
        <div style="flex:1 1 280px;display:flex;flex-direction:column;gap:4px;position:sticky;top:80px">
          {PROJECTS.map((p, i) => (
            <button type="button" data-work-pick={i} style="all:unset;cursor:pointer;display:grid;grid-template-columns:28px minmax(0,1fr) auto;align-items:center;gap:12px;padding:16px 14px;border-radius:10px;transition:background .3s">
              <span data-work-num={i} style={`font-family:'Martian Mono',monospace;font-size:11px;color:${i === 0 ? "var(--acc)" : "var(--mute)"}`}>{p.num}</span>
              <span style={`display:flex;flex-direction:column;gap:3px${p.archived ? ";color:var(--mute)" : ""}`}><span style="font-size:19px;font-weight:600;letter-spacing:-.01em">{p.title}{p.archived && " †"}</span><span style="font-family:'Martian Mono',monospace;font-size:10px;color:var(--mute)">{p.stackShort}</span></span>
              {p.badge ? (
                <span style="font-family:'Martian Mono',monospace;font-size:9px;text-transform:uppercase;padding:3px 7px;border-radius:4px;background:var(--acc);color:var(--on-acc)"><span data-en="">latest</span><span data-es="">nuevo</span></span>
              ) : p.archived ? (
                <span style="width:7px;height:7px;border-radius:50%;border:1.5px solid var(--mute);box-sizing:border-box"></span>
              ) : (
                <span style="width:7px;height:7px;border-radius:50%;background:var(--acc)"></span>
              )}
            </button>
          ))}
          <div style="margin:12px 14px 0;height:2px;background:var(--line);border-radius:2px;overflow:hidden"><div id="work-progress" style="height:100%;width:0;background:var(--acc)"></div></div>
        </div>

        <div style="flex:999 1 480px;min-width:0;display:grid">
          {PROJECTS.map((p, i) => (
            <article data-work-article={i} style={`grid-area:1/1;display:flex;flex-direction:column;gap:18px;transition:opacity .5s ease,transform .6s cubic-bezier(.2,.7,.2,1);opacity:${i === 0 ? 1 : 0};transform:${i === 0 ? "none" : "translateY(14px)"};pointer-events:${i === 0 ? "auto" : "none"}`}>
              {p.archived ? (
                <div id="zatobox-media" style="position:relative;aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:var(--card);border:1px solid var(--line);filter:grayscale(1)">
                  <div data-zb-slide="0" style="position:absolute;inset:0;transition:opacity .4s ease">
                    <Image src={p.img} alt={p.alt} width={960} height={600} style="width:100%;height:100%;object-fit:cover;display:block" />
                  </div>
                  <div data-zb-slide="1" style="position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .4s ease">
                    <video style="width:100%;height:100%;object-fit:cover;display:block" poster={zatobox.src} muted loop playsinline controls preload="none">
                      <source src={zatoboxVideo} type="video/mp4" />
                    </video>
                  </div>
                  <div style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:999px;background:rgba(10,11,10,.72);backdrop-filter:blur(4px);z-index:2">
                    <button type="button" data-zb-dot="0" aria-label="Screenshot" style="all:unset;cursor:pointer;font-family:'Martian Mono',monospace;font-size:10px;letter-spacing:.04em;text-transform:uppercase;color:#eceee8;padding:2px 6px;border-radius:999px;background:oklch(0.88 0.19 125);transition:all .3s"><span data-en="">image</span><span data-es="">imagen</span></button>
                    <button type="button" data-zb-dot="1" aria-label="Video" style="all:unset;cursor:pointer;font-family:'Martian Mono',monospace;font-size:10px;letter-spacing:.04em;text-transform:uppercase;color:#8b8f87;padding:2px 6px;border-radius:999px;background:transparent;transition:all .3s">video</button>
                  </div>
                </div>
              ) : (
                <div style="position:relative;aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:var(--card);border:1px solid var(--line)">
                  <Image src={p.img} alt={p.alt} width={960} height={600} style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>
              )}
              <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--mute)">
                <span><span data-en="">{p.catEn}</span><span data-es="">{p.catEs}</span></span>
                {p.archived ? (
                  <span style="display:flex;align-items:center;gap:8px;text-transform:none"><span style="width:6px;height:6px;border-radius:50%;border:1.5px solid var(--mute)"></span>410 Gone · in memoriam</span>
                ) : (
                  <a href={p.url} target="_blank" style="display:flex;align-items:center;gap:8px;text-transform:none;text-decoration:none;color:var(--acc)"><span style="width:6px;height:6px;border-radius:50%;background:var(--acc);animation:pulse 2s infinite"></span>200 · {p.domain} ↗</a>
                )}
              </div>
              <h3 style={`margin:0;font-size:clamp(34px,4.4vw,56px);line-height:1;font-weight:600;letter-spacing:-.035em${p.archived ? ";color:var(--mute)" : ""}`}>{p.title}{p.archived && <span style="font-weight:300"> †</span>}</h3>
              <p style="margin:0;font-size:17px;line-height:1.6;color:var(--mute);max-width:62ch;text-wrap:pretty"><span data-en="">{p.descEn}</span><span data-es="">{p.descEs}</span></p>
              {p.archived && (
                <code style="font-family:'Martian Mono',monospace;font-size:12px;line-height:1.7;color:var(--mute)">// <span data-en="">{p.memorialEn}</span><span data-es="">{p.memorialEs}</span></code>
              )}
              <code style="font-family:'Martian Mono',monospace;font-size:12px;line-height:1.8;color:var(--mute)"><span style="color:var(--acc2)">stack</span> = [{p.stack.map((s, si) => <>{si > 0 && ", "}<span style="color:var(--acc)">"{s}"</span></>)}]</code>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" style="padding-bottom:clamp(72px,10vw,128px)">
      <div data-reveal="" style="position:relative;border:1px solid var(--line);border-radius:20px;background:var(--card);padding:clamp(28px,5vw,64px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:36px;align-items:end;overflow:hidden">
        <div style="display:flex;flex-direction:column;gap:22px">
          <span style="display:flex;align-items:center;gap:10px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--acc)"><span style="width:7px;height:7px;border-radius:50%;background:var(--acc);animation:pulse 2s infinite"></span><span data-en="">Let's talk</span><span data-es="">Hablemos</span></span>
          <h2 style="margin:0;font-size:clamp(44px,7vw,104px);line-height:.92;font-weight:600;letter-spacing:-.045em"><span data-en="">Need something built?</span><span data-es="">¿Necesitas algo?</span><span style="display:inline-block;width:.4em;height:.75em;margin-left:.12em;background:var(--acc);animation:blink 1.1s step-end infinite"></span></h2>
          <p style="margin:0;font-size:18px;line-height:1.55;color:var(--mute)"><span data-en="">Reach out and let's talk about your project.</span><span data-es="">Contáctame y hablamos sobre tu proyecto.</span></p>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;font-family:'Martian Mono',monospace;font-size:13px">
          <a data-en="" href={WHATSAPP_URL_EN} target="_blank" class="hover-bright" style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 22px;border-radius:12px;background:var(--acc);color:var(--on-acc);text-decoration:none"><span>$ send --whatsapp</span><span>→</span></a>
