---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Github, Linkedin, Instagram, Mail, Youtube } from "lucide-astro";
import { MessageCircle } from "lucide-astro";

import profile from "../assets/profile.jpg";

import tokenit from "../assets/projects/tokenit.png";
import tokenitApp from "../assets/projects/app-tokenit.png";
import zatobox from "../assets/projects/zatobox.png";
import consentido from "../assets/projects/consentido.png";

import elevate from "../assets/sideprojects/elevate.png";
import atlas from "../assets/sideprojects/atlas.png";
import aurora from "../assets/sideprojects/aurora.png";
import coffee from "../assets/sideprojects/coffee.png";

import arc1 from "../assets/projects/Arc/1.png";
import arc2 from "../assets/projects/Arc/2.png";
import arc3 from "../assets/projects/Arc/3.png";
import outdoor1 from "../assets/projects/outdoor/1.png";
import outdoor2 from "../assets/projects/outdoor/2.png";
import outdoor3 from "../assets/projects/outdoor/3.png";
import muebles1 from "../assets/projects/muebles/1.png";
import muebles2 from "../assets/projects/muebles/2.png";
import muebles3 from "../assets/projects/muebles/3.png";
import prisma1 from "../assets/projects/prisma/1.png";
import prisma2 from "../assets/projects/prisma/2.png";
import prisma3 from "../assets/projects/prisma/3.png";

const BG = "#0E0E0E";
const FG = "#FFFFFF";
const MUTED = "rgba(255,255,255,.58)";
const FAINT = "rgba(255,255,255,.34)";
const LINE = "rgba(255,255,255,.1)";
const ACCENT = "#554070";

const PROJECTS = [
  { n: "01", title: "Tokenit", cat: "Investor App · Web3", img: tokenitApp, alt: "Tokenit Investor App", desc: "Investor dashboard for a Chilean blockchain real-estate platform — real-time monitoring, KYC, digital signing and AI risk scoring.", tags: ["Meteor.js", "React", "Web3"], url: "https://app.tokenit.cl" },
  { n: "02", title: "Tokenit", cat: "Landing Page · Web3", img: tokenit, alt: "Tokenit Landing", desc: "Public marketplace connecting investors with tokenized real-estate opportunities backed by real assets.", tags: ["Gatsby", "Python", "MongoDB"], url: "https://tokenit.cl" },
  { n: "03", title: "ZatoBox", cat: "Open Source · POS", img: zatobox, alt: "ZatoBox", desc: "Open-source point-of-sale system with real-time inventory, order management and a Docker-based deployment pipeline.", tags: ["Next.js", "Supabase", "Docker"], url: "https://www.zatobox.io/" },
  { n: "04", title: "ConSentido Cognitivo", cat: "Psicopedagogía · Accessibility", img: consentido, alt: "ConSentido Cognitivo", desc: "Accessible platform for a psychopedagogy practice, built to make cognitive-support resources easy to reach for families.", tags: ["Next.js", "Tailwind", "Firebase"], url: "https://www.consentidocognitivo.site/" },
];

const MORE_WORK_FULL = [
  { id: "elevate", title: "Elevate Gym", img: elevate },
  { id: "atlas", title: "Atlas", img: atlas },
  { id: "aurora", title: "Aurora AI", img: aurora },
  { id: "coffee", title: "Noma Coffee", img: coffee },
];

const MORE_WORK_CAROUSEL = [
  { id: "arc", title: "Arc & Form", imgs: [arc1, arc2, arc3] },
  { id: "outdoor", title: "Wild Oak Supply", imgs: [outdoor1, outdoor2, outdoor3] },
  { id: "muebles", title: "Muebles & Decoración", imgs: [muebles1, muebles2, muebles3] },
  { id: "prisma", title: "Prisma Events", imgs: [prisma1, prisma2, prisma3] },
];

const TIMELINE = [
  { id: "codigo-facilito", year: "2026", type: "Education", title: "Codigo Facilito", role: "Modern Frontend Bootcamp", date: "Graduated Jan 2026" },
  { id: "niuro", year: "2025", type: "Work", title: "Niuro", role: "Full Stack Engineer · Marketplace Platform", desc: "Placed at Tokenit, a Chilean blockchain-based real-estate investment platform.", date: "Dec 2025 — Present" },
  { id: "zatobox-work", year: "2025", type: "Work", title: "ZatoBox", role: "Full Stack & Cloud Solutions Architect", desc: "DevOps lead overseeing the full software development lifecycle.", date: "Aug — Dec 2025" },
  { id: "dragon-pyramid", year: "2025", type: "Work", title: "Dragon Pyramid", role: "Full Stack Engineer", desc: "Front-end focused work — Next.js 14, TailwindCSS, Shadcn UI, NextAuth, Supabase.", date: "Jun — Oct 2025" },
  { id: "issd", year: "2025", type: "Education", title: "Inst. Sup. Santo Domingo", role: "Web Development & Mobile Applications", date: "2025 — Present" },
  { id: "henry", year: "2025", type: "Education", title: "Henry", role: "Full Stack Development Bootcamp", date: "Graduated Jun 2025" },
  { id: "coderhouse", year: "2025", type: "Education", title: "Coderhouse", role: "Full Stack Development Program", date: "Graduated Feb 2025" },
  { id: "ysc", year: "2024", type: "Work", title: "YSC by frysccou", role: "Full Stack Engineer & Content Creator", desc: "Independent developer building functional, well-structured digital solutions and creating tech content.", date: "Aug 2024 — Present" },
];

const TIKTOK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>`;

const KNOWLEDGE = [
  { id: "core-languages", label: "Languages", items: ["HTML", "CSS", "JavaScript", "TypeScript", "Java", "Python", "PHP"] },
  { id: "frontend", label: "Frontend", items: ["React", "Vue", "Angular", "Astro"] },
  { id: "backend", label: "Backend", items: ["Node.js", "NestJS", "Spring Boot", "Django", "FastAPI", "Laravel"] },
  { id: "meta-frameworks", label: "Frameworks", items: ["Next.js", "Nuxt.js", "Meteor", "Gatsby"] },
  { id: "mobile", label: "Mobile", items: ["Flutter", "Dart", "React Native"] },
  { id: "databases", label: "Databases", items: ["MongoDB", "Supabase", "Firebase", "PostgreSQL", "MySQL"] },
  { id: "tools-devops", label: "Tools", items: ["Docker", "Git", "GitHub", "AWS", "Figma"] },
];

const RULER_TICKS = Array.from({ length: 21 }, (_, i) => i * 100);

const WHATSAPP_NUMBER = "541167672197";
const CONTACT_EMAIL = "franespindola71@gmail.com";

const WHATSAPP_MSG_EN = "Hi Francisco! I found your portfolio and I'd like to talk about a project.";
const WHATSAPP_MSG_ES = "¡Hola Francisco! Vi tu portfolio y me gustaría hablar sobre un proyecto.";
const WHATSAPP_URL_EN = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MSG_EN)}`;
const WHATSAPP_URL_ES = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MSG_ES)}`;

const EMAIL_SUBJECT_EN = "Let's talk about a project";
const EMAIL_SUBJECT_ES = "Hablemos sobre un proyecto";
const EMAIL_BODY_EN = "Hi Francisco! I found your portfolio and I'd like to talk about a project.";
const EMAIL_BODY_ES = "¡Hola Francisco! Vi tu portfolio y me gustaría hablar sobre un proyecto.";
const EMAIL_URL_EN = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(EMAIL_SUBJECT_EN)}&body=${encodeURIComponent(EMAIL_BODY_EN)}`;
const EMAIL_URL_ES = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(EMAIL_SUBJECT_ES)}&body=${encodeURIComponent(EMAIL_BODY_ES)}`;
---

<Layout>
  <div class="root" style={`background:${BG}; color:${FG}; min-height:100vh; font-family:'Inter',sans-serif;`}>

    <!-- ARTBOARD DRESSING -->
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="ruler ruler-top" aria-hidden="true">
      {RULER_TICKS.map((v) => <span class="ruler-tick" style={`left:${v}px;`}>{v}</span>)}
    </div>
    <div class="ruler ruler-left" aria-hidden="true">
      {RULER_TICKS.map((v) => <span class="ruler-tick" style={`top:${v}px;`}>{v}</span>)}
    </div>

    <div class="wrap">
      <span class="corner corner-tl" aria-hidden="true">+</span>
      <span class="corner corner-tr" aria-hidden="true">+</span>
      <span class="corner corner-bl" aria-hidden="true">+</span>
      <span class="corner corner-br" aria-hidden="true">+</span>
      <span class="artboard-tag artboard-tag-tl" aria-hidden="true">F.E — PORTFOLIO</span>
      <span class="artboard-tag artboard-tag-br" aria-hidden="true">680 × ∞</span>

      <!-- TOP BAR -->
      <div class="topbar">
        <button type="button" class="lang-toggle" aria-label="Switch language">EN / ES</button>
      </div>

      <!-- INTRO -->
      <header id="top" class="section intro">
        <div class="who">
          <Image src={profile} alt="Francisco Espindola" width={160} height={160} class="avatar" />
          <div>
            <h1 class="name">Francisco Espindola</h1>
            <p class="role" data-i18n="intro.role">Full Stack Engineer</p>
          </div>
        </div>

        <p class="bio" data-i18n="intro.bio1">
          I'm a Full Stack Engineer based in Buenos Aires, Argentina, building digital products end to end — from interface to architecture.
        </p>
        <p class="bio">
          <span data-i18n="intro.bio2a">I care <em>deeply</em> about craft and clean code, and I like turning ideas into things people actually enjoy using. I also make content on</span> <a class="icon-link" href="https://www.youtube.com/@frysccu" target="_blank" rel="noopener"><Youtube size={14} /> YouTube</a> <span data-i18n="intro.and">and</span> <a class="icon-link" href="https://instagram.com/frysccu" target="_blank" rel="noopener"><Instagram size={14} /> Instagram</a>.
        </p>
        <p class="bio">
          <span data-i18n="intro.bio3a">You can reach me on</span> <a class="icon-link" href="https://www.linkedin.com/in/espindola-francisco" target="_blank" rel="noopener"><Linkedin size={14} /> LinkedIn</a> <span data-i18n="intro.bio3b">and via</span> <a class="icon-link" href="mailto:franespindola71@gmail.com"><Mail size={14} /> <span data-i18n="intro.email">email</span> <span class="email-hint">(franespindola71@gmail.com)</span></a><span data-i18n="intro.bio3c">, see my code on</span> <a class="icon-link" href="https://github.com/esspindola" target="_blank" rel="noopener"><Github size={14} /> GitHub</a>.
        </p>
      </header>

      <!-- PROJECTS -->
      <section id="work" class="section reveal">
        <h2 class="label" data-i18n="work.label">Projects</h2>
        <div class="proj-list">
          {PROJECTS.map(({ n, title, cat, img, alt, desc, tags, url }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="proj-row">
              <Image src={img} alt={alt} width={160} height={160} class="proj-thumb" loading="lazy" />
              <div class="proj-body">
                <div class="proj-head">
                  <span class="proj-title">{title}</span>
                  <span class="proj-arrow">↗</span>
                </div>
                <div class="proj-cat" data-i18n={`work.${n}.cat`}>{cat}</div>
                <p class="proj-desc" data-i18n={`work.${n}.desc`}>{desc}</p>
                <div class="proj-tags">{tags.join(" · ")}</div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- CONTACT CTA -->
      <section id="whatsapp-cta" class="section reveal">
        <span class="label" data-i18n="whatsapp.eyebrow">Let's talk</span>
        <h2 class="contact-cta-title" data-i18n="whatsapp.title">Need something built?</h2>
        <p class="bio contact-cta-desc" data-i18n="whatsapp.desc">Reach out and let's talk about your project.</p>
        <div class="contact-cta-buttons">
          <a href={WHATSAPP_URL_EN} target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn-primary" data-wa-link data-wa-en={WHATSAPP_URL_EN} data-wa-es={WHATSAPP_URL_ES}>
            <MessageCircle size={16} />
            <span data-i18n="whatsapp.cta">Send me a WhatsApp</span>
          </a>
          <a href={EMAIL_URL_EN} class="contact-btn" data-email-link data-email-en={EMAIL_URL_EN} data-email-es={EMAIL_URL_ES}>
            <Mail size={16} />
            <span data-i18n="email.cta">Email me</span>
          </a>
        </div>
      </section>

      <!-- MORE WORK -->
      <section id="more-work" class="section reveal">
        <h2 class="label" data-i18n="more.label">More work</h2>
        <div class="more-grid">
          {MORE_WORK_FULL.map(({ id, title, img }) => (
            <button type="button" class="more-card more-card-full" data-lightbox-open={id}>
              <Image src={img} alt={title} width={300} height={200} loading="lazy" />
              <span>{title}</span>
            </button>
          ))}
        </div>

        <div class="carousel-grid">
          {MORE_WORK_CAROUSEL.map(({ id, title, imgs }) => (
            <div class="more-card more-card-carousel" data-carousel={id}>
              <div class="carousel-track">
                {imgs.map((img, i) => (
                  <Image src={img} alt={`${title} ${i + 1}`} width={640} height={400} loading="lazy" class="carousel-slide" data-slide={i} />
                ))}
              </div>
              <div class="carousel-dots">
                {imgs.map((_, i) => <span class="carousel-dot" data-dot={i}></span>)}
              </div>
              <span>{title}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- LIGHTBOX -->
      <div id="lightbox" class="lightbox" aria-hidden="true">
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">✕</button>
        <div class="lightbox-scroll">
          {MORE_WORK_FULL.map(({ id, title, img }) => (
            <Image src={img} alt={title} inferSize loading="lazy" class="lightbox-img" data-lightbox-img={id} />
          ))}
        </div>
      </div>

      <!-- EXPERIENCE & EDUCATION -->
      <section id="experience" class="section reveal">
        <h2 class="label" data-i18n="log.label">Experience &amp; education</h2>
        <div class="log-list">
          {TIMELINE.map(({ id, type, title, role, desc, date }) => (
            <div class="log-row">
              <span class="log-type" data-i18n={`log.type.${type.toLowerCase()}`}>{type}</span>
              <div class="log-body">
                <div class="log-top">
                  <h3>{title}</h3>
                  <span class="log-date" data-i18n={`log.${id}.date`}>{date}</span>
                </div>
                <div class="log-role" data-i18n={`log.${id}.role`}>{role}</div>
                {desc && <p class="log-desc" data-i18n={`log.${id}.desc`}>{desc}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- KNOWLEDGE -->
      <section id="knowledge" class="section reveal">
        <h2 class="label" data-i18n="tech.label">Knowledge</h2>
        <div class="know-list">
          {KNOWLEDGE.map(({ id, label, items }) => (
            <div class="know-row">
              <span class="know-cat" data-i18n={`tech.label.${id}`}>{label}</span>
              <span class="know-items">{items.join(" · ")}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- CONTACT / FOOTER -->
      <footer id="contact" class="section reveal">
        <h2 class="label" data-i18n="contact.label">Elsewhere</h2>
        <div class="socials">
          <a href="https://github.com/esspindola" target="_blank" rel="noopener" aria-label="GitHub"><Github size={18} /></a>
          <a href="https://www.linkedin.com/in/espindola-francisco" target="_blank" rel="noopener" aria-label="LinkedIn"><Linkedin size={18} /></a>
          <a href="https://instagram.com/frysccu" target="_blank" rel="noopener" aria-label="Instagram"><Instagram size={18} /></a>
          <a href="https://www.youtube.com/@frysccu" target="_blank" rel="noopener" aria-label="YouTube"><Youtube size={18} /></a>
          <a href="https://www.tiktok.com/@frysccouu" target="_blank" rel="noopener" aria-label="TikTok" set:html={TIKTOK_ICON} />
          <a href="mailto:franespindola71@gmail.com" aria-label="Email"><Mail size={18} /></a>
        </div>
        <div class="foot-line">
          <span>© 2026 Francisco Espindola</span>
          <span data-i18n="footer.location">Buenos Aires, Argentina</span>
        </div>
      </footer>

    </div>
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    gsap.from('.intro > *', { opacity: 0, y: 14, stagger: 0.08, duration: 0.7, ease: 'power2.out' });

    gsap.utils.toArray('.reveal').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 24, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    gsap.utils.toArray('.proj-row, .log-row, .know-row, .more-card, .more-card-carousel').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 14, duration: 0.6, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 92%' },
      });
    });
  }

  // i18n — EN (default, baked into the markup) / ES toggle
  const ES = {
    'intro.role': 'Full Stack Engineer',
    'intro.bio1': 'Soy Full Stack Engineer con base en Buenos Aires, Argentina, construyendo productos digitales de punta a punta — desde la interfaz hasta la arquitectura.',
    'intro.bio2a': 'Me importa <em>profundamente</em> el cuidado del detalle y el código limpio, y me gusta convertir ideas en cosas que la gente realmente disfrute usar. También hago contenido en',
    'intro.and': 'e',
    'intro.bio3a': 'Puedes contactarme por',
    'intro.bio3b': 'y por',
    'intro.bio3c': ', y ver mi código en',
    'intro.email': 'correo',

    'work.label': 'Proyectos',
    'work.01.cat': 'App de Inversores · Web3',
    'work.01.desc': 'Panel de inversores para una plataforma chilena de real estate en blockchain — monitoreo en tiempo real, KYC, firma digital y scoring de riesgo con IA.',
    'work.02.cat': 'Landing Page · Web3',
    'work.02.desc': 'Marketplace público que conecta inversores con oportunidades de real estate tokenizado respaldadas por activos reales.',
    'work.03.cat': 'Open Source · POS',
    'work.03.desc': 'Sistema de punto de venta open-source con inventario en tiempo real, gestión de pedidos y un pipeline de despliegue basado en Docker.',
    'work.04.cat': 'Psicopedagogía · Accesibilidad',
    'work.04.desc': 'Plataforma accesible para un consultorio de psicopedagogía, pensada para que las familias accedan fácilmente a recursos de apoyo cognitivo.',

    'whatsapp.eyebrow': 'Hablemos',
    'whatsapp.title': '¿Necesitas algo?',
    'whatsapp.desc': 'Contáctame y hablamos sobre tu proyecto.',
    'whatsapp.cta': 'Mándame un WhatsApp',
    'email.cta': 'Escríbeme un email',

    'more.label': 'Más trabajos',

    'log.label': 'Experiencia y educación',
    'log.type.education': 'Educación', 'log.type.work': 'Trabajo',
    'log.codigo-facilito.role': 'Bootcamp de Frontend Moderno', 'log.codigo-facilito.date': 'Graduado en enero de 2026',
    'log.niuro.role': 'Full Stack Engineer · Plataforma Marketplace',
    'log.niuro.desc': 'Asignado a Tokenit, una plataforma chilena de inversión inmobiliaria basada en blockchain.',
    'log.niuro.date': 'Dic 2025 — Presente',
    'log.zatobox-work.role': 'Full Stack & Cloud Solutions Architect',
    'log.zatobox-work.desc': 'Líder de DevOps a cargo de todo el ciclo de vida del desarrollo de software.',
    'log.zatobox-work.date': 'Ago — Dic 2025',
    'log.dragon-pyramid.role': 'Full Stack Engineer',
    'log.dragon-pyramid.desc': 'Trabajo enfocado en frontend — Next.js 14, TailwindCSS, Shadcn UI, NextAuth, Supabase.',
    'log.dragon-pyramid.date': 'Jun — Oct 2025',
    'log.issd.role': 'Desarrollo Web y Aplicaciones Móviles', 'log.issd.date': '2025 — Presente',
    'log.henry.role': 'Bootcamp de Desarrollo Full Stack', 'log.henry.date': 'Graduado en junio de 2025',
    'log.coderhouse.role': 'Programa de Desarrollo Full Stack', 'log.coderhouse.date': 'Graduado en febrero de 2025',
    'log.ysc.role': 'Full Stack Engineer & Creador de Contenido',
    'log.ysc.desc': 'Desarrollador independiente construyendo soluciones digitales funcionales y creando contenido tech.',
    'log.ysc.date': 'Ago 2024 — Presente',

    'tech.label': 'Conocimientos',
    'tech.label.core-languages': 'Lenguajes', 'tech.label.frontend': 'Frontend', 'tech.label.backend': 'Backend',
    'tech.label.meta-frameworks': 'Frameworks', 'tech.label.mobile': 'Mobile',
    'tech.label.databases': 'Bases de datos', 'tech.label.tools-devops': 'Herramientas',

    'contact.label': 'Y en otros lados',
    'footer.location': 'Buenos Aires, Argentina',
  };

  const LANG_KEY = 'site-lang';
  const originalHTML = new WeakMap();
  let currentLang = 'en';

  function applyLang(lang) {
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      if (!originalHTML.has(el)) originalHTML.set(el, el.innerHTML);
      const key = el.getAttribute('data-i18n');
      const orig = originalHTML.get(el);
      el.innerHTML = (lang === 'es' && ES[key]) ? ES[key] : orig;
    });
    currentLang = lang;
    document.documentElement.lang = lang;
    document.querySelectorAll('.lang-toggle').forEach((btn) => {
      btn.textContent = lang === 'en' ? 'EN / ES' : 'ES / EN';
    });
    document.querySelectorAll('[data-wa-link]').forEach((link) => {
      const url = lang === 'es' ? link.getAttribute('data-wa-es') : link.getAttribute('data-wa-en');
      if (url) link.setAttribute('href', url);
    });
    document.querySelectorAll('[data-email-link]').forEach((link) => {
      const url = lang === 'es' ? link.getAttribute('data-email-es') : link.getAttribute('data-email-en');
      if (url) link.setAttribute('href', url);
    });
    try { localStorage.setItem(LANG_KEY, lang); } catch {}
  }

  document.querySelectorAll('.lang-toggle').forEach((btn) => {
    btn.addEventListener('click', () => applyLang(currentLang === 'en' ? 'es' : 'en'));
  });

  let storedLang = 'en';
  try { storedLang = localStorage.getItem(LANG_KEY) || 'en'; } catch {}
  if (storedLang === 'es') applyLang('es');

  // LIGHTBOX — full-page screenshots, scrollable top to bottom
  const lightbox = document.getElementById('lightbox');
  const openLightbox = (id) => {
    if (!lightbox) return;
    lightbox.querySelectorAll('[data-lightbox-img]').forEach((img) => {
      img.style.display = img.getAttribute('data-lightbox-img') === id ? 'block' : 'none';
    });
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };
  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };
  document.querySelectorAll('[data-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => openLightbox(btn.getAttribute('data-lightbox-open')));
  });
  document.querySelectorAll('[data-lightbox-close]').forEach((btn) => {
    btn.addEventListener('click', closeLightbox);
  });
  lightbox?.addEventListener('click', (e) => {
    if (!e.target.closest('.lightbox-img')) closeLightbox();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

  // CAROUSELS — each project rotates independently through its own 3 images
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    let index = 0;

    const goTo = (i) => {
      index = i;
      slides.forEach((s, si) => s.classList.toggle('is-active', si === index));
      dots.forEach((d, di) => d.classList.toggle('is-active', di === index));
    };
    goTo(0);

    dots.forEach((dot, di) => dot.addEventListener('click', () => goTo(di)));

    let timer = setInterval(() => goTo((index + 1) % slides.length), 3200);
    carousel.addEventListener('mouseenter', () => clearInterval(timer));
    carousel.addEventListener('mouseleave', () => {
      timer = setInterval(() => goTo((index + 1) % slides.length), 3200);
    });
  });
</script>

