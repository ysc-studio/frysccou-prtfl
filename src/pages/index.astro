          <div class="hover-line" style="display:flex;gap:16px;padding:0 18px"><span style="flex:none;width:18px;text-align:right;opacity:.5">5</span><span style="padding-left:2ch;text-wrap:pretty"><span style="color:var(--fg)">frameworks</span>: [<span style="color:var(--acc)">"Next.js"</span>, <span style="color:var(--acc)">"Nuxt.js"</span>, <span style="color:var(--acc)">"Meteor"</span>, <span style="color:var(--acc)">"Gatsby"</span>],</span></div>
          <div class="hover-line" style="display:flex;gap:16px;padding:0 18px"><span style="flex:none;width:18px;text-align:right;opacity:.5">6</span><span style="padding-left:2ch;text-wrap:pretty"><span style="color:var(--fg)">mobile</span>: [<span style="color:var(--acc)">"Flutter"</span>, <span style="color:var(--acc)">"Dart"</span>, <span style="color:var(--acc)">"React Native"</span>],</span></div>
          <div class="hover-line" style="display:flex;gap:16px;padding:0 18px"><span style="flex:none;width:18px;text-align:right;opacity:.5">7</span><span style="padding-left:2ch;text-wrap:pretty"><span style="color:var(--fg)">databases</span>: [<span style="color:var(--acc)">"MongoDB"</span>, <span style="color:var(--acc)">"Supabase"</span>, <span style="color:var(--acc)">"Firebase"</span>, <span style="color:var(--acc)">"PostgreSQL"</span>, <span style="color:var(--acc)">"MySQL"</span>],</span></div>
          <div class="hover-line" style="display:flex;gap:16px;padding:0 18px"><span style="flex:none;width:18px;text-align:right;opacity:.5">8</span><span style="padding-left:2ch;text-wrap:pretty"><span style="color:var(--fg)">tools</span>: [<span style="color:var(--acc)">"Docker"</span>, <span style="color:var(--acc)">"Git"</span>, <span style="color:var(--acc)">"GitHub"</span>, <span style="color:var(--acc)">"AWS"</span>, <span style="color:var(--acc)">"Figma"</span>],</span></div>
          <div style="display:flex;gap:16px;padding:0 18px"><span style="flex:none;width:18px;text-align:right;opacity:.5">9</span><span>{`}`} <span style="color:var(--acc2)">as const</span>;<span style="display:inline-block;width:.6em;height:1.1em;margin-left:4px;vertical-align:-.2em;background:var(--acc);animation:blink 1.1s step-end infinite"></span></span></div>
        </div>
      </div>
    </section>

    <section style="padding-bottom:clamp(56px,8vw,96px)">
