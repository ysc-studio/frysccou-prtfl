---
import Layout from "./Layout.astro";
import Bi from "../components/sign/Bi.astro";
import LangSwitch from "../components/LangSwitch.astro";
import "../styles/sign.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "app" | "terms";
  compact?: boolean;
  robots?: string;
  jsonLdExtra?: object[];
}

const { title, description, active = "home", compact = false, robots, jsonLdExtra } = Astro.props;
---

<Layout
  title={title}
  description={description}
  robots={robots}
  jsonLdExtra={jsonLdExtra}
  image="/YSC/og-sign.png"
  imageWidth={1200}
  imageHeight={630}
  imageAlt="YSC Sign — sign PDFs online, free and private"
>
  <div class="sg-root">
    <header class="sg-header">
      <div class="sg-header-in">
        <a href="/sign" class="sg-brand" aria-label="YSC Sign">
          <img src="/YSC/YSC-Sign-nav.png" alt="YSC Sign" width="279" height="132" />
        </a>
        <div class="hdr-right">
        <nav class="sg-nav">
          <a href="/sign" class:list={[{ "is-active": active === "home" }]}>./<Bi en="home" es="inicio" /></a>
          <a href="/sign/app" class:list={[{ "is-active": active === "app" }]}>./<Bi en="editor" es="editor" /></a>
          <a href="/sign/terms" class:list={[{ "is-active": active === "terms" }]}>./<Bi en="terms" es="términos" /></a>
          <a href="/" class="sg-back">← <Bi en="portfolio" es="portfolio" /></a>
          <button id="sg-theme" type="button" class="sg-toggle" aria-label="Toggle theme">◐ dark</button>
        </nav>
        <LangSwitch enId="sg-lang-en" esId="sg-lang-es" />
        </div>
      </div>
    </header>

    <slot />

    {
      !compact && (
        <footer class="sg-footer">
          <div class="sg-footer-in">
            <span>
              © {new Date().getFullYear()} YSC · Francisco Espindola · Buenos Aires
            </span>
            <span class="sg-footer-links">
              <a href="/sign/terms"><Bi en="Terms & Privacy" es="Términos y Privacidad" /></a>
              <a href="/">ysc.com.ar</a>
            </span>
          </div>
        </footer>
      )
    }
  </div>
</Layout>

<script>
  const THEME_KEY = "ysc-theme";
  const LANG_KEY = "ysc-lang";
  const root = document.documentElement;
  let theme = "dark";
  let lang = "en";
  try {
    theme = localStorage.getItem(THEME_KEY) === "light" ? "light" : "dark";
    lang = localStorage.getItem(LANG_KEY) === "es" ? "es" : "en";
  } catch {}

  function apply() {
    root.dataset.theme = theme;
    root.dataset.lang = lang;
    root.lang = lang;
    try {
      localStorage.setItem(THEME_KEY, theme);
      localStorage.setItem(LANG_KEY, lang);
    } catch {}
    const tb = document.getElementById("sg-theme");
    if (tb) tb.textContent = theme === "dark" ? "◐ dark" : "◑ light";
    const en = document.getElementById("sg-lang-en");
    const es = document.getElementById("sg-lang-es");
    en?.classList.toggle("is-on", lang === "en");
    es?.classList.toggle("is-on", lang === "es");
  }

  apply();
  document.getElementById("sg-lang-en")?.addEventListener("click", () => {
    lang = "en";
    apply();
  });
  document.getElementById("sg-lang-es")?.addEventListener("click", () => {
    lang = "es";
    apply();
  });
  document.getElementById("sg-theme")?.addEventListener("click", () => {
    theme = theme === "dark" ? "light" : "dark";
    apply();
  });

  const motionOff =
    matchMedia("(prefers-reduced-motion: reduce)").matches ||
    (() => {
      try {
        return localStorage.getItem("ysc-motion") === "off";
      } catch {
        return false;
      }
    })();

  function reveal() {
    const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const el = en.target as HTMLElement;
          io.unobserve(el);
          el.classList.add("is-in");
          setTimeout(() => {
            el.classList.remove("is-pending");
            el.classList.add("is-done");
          }, 1600);
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    const groups = new Map<Element, number>();
    els.forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight) return;
      const parent = el.parentElement as Element;
      const n = groups.get(parent) ?? 0;
      groups.set(parent, n + 1);
      el.style.setProperty("--d", Math.min(n, 5) * 80 + "ms");
      el.classList.add("is-pending");
      io.observe(el);
    });
  }

  function scramble(el: HTMLElement) {
    const final = el.textContent ?? "";
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&";
    const start = performance.now();
    const dur = 900;
    function tick(now: number) {
      const t = Math.min(1, (now - start) / dur);
      const lock = Math.floor(t * final.length);
      let out = "";
      for (let i = 0; i < final.length; i++) {
        const c = final[i];
        out += i < lock || c === " " || /[.,!?]/.test(c) ? c : chars[Math.floor(Math.random() * chars.length)];
      }
      el.textContent = t < 1 ? out : final;
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if (!motionOff) {
    reveal();
    setTimeout(() => {
      document.querySelectorAll<HTMLElement>(".sg-h1 em [data-en], .sg-h1 em [data-es]").forEach(scramble);
    }, 350);
  }
</script>
