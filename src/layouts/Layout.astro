---
import "../styles/globals.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  jsonLdExtra?: object[];
}

const {
  title = "YSC — Francisco Espindola · Full Stack Engineer",
  description = "YSC is the studio of Francisco Espindola — a Full Stack Engineer building premium digital products end to end, from pixel-perfect interfaces to scalable system architecture.",
  image = "/YSC/logo+text.png",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  jsonLdExtra = [],
  imageWidth = 1920,
  imageHeight = 819,
  imageAlt = "YSC — Francisco Espindola",
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.href);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = new URL(image, siteURL);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "YSC",
      description,
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": `${siteURL}#person`,
      name: "Francisco Espindola",
      alternateName: "frysccou",
      url: siteURL,
      image: ogImage,
      jobTitle: "Full Stack Engineer",
      worksFor: { "@type": "Organization", name: "YSC" },
      address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
      sameAs: [
        "https://github.com/esspindola",
        "https://www.linkedin.com/in/espindola-francisco",
        "https://instagram.com/fryscco_",
      ],
    },
  ],
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('lang');
          if (q === 'es' || q === 'en') {
            localStorage.setItem('ysc-lang', q);
            localStorage.setItem('ysc-lang-chosen', '1');
          }
          if (localStorage.getItem('ysc-theme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
          if (localStorage.getItem('ysc-lang') === 'es') {
            document.documentElement.setAttribute('data-lang', 'es');
            document.documentElement.lang = 'es';
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Espindola" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#0a0b0a" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YSC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@frysccou" />
    <meta name="twitter:creator" content="@frysccou" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" type="image/x-icon" href="/YSC/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/YSC/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/YSC/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/YSC/favicons/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/YSC/favicons/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/YSC/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/YSC/favicons/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Doto:wght@500..900&family=Martian+Mono:wght@300..600&display=swap"
      rel="stylesheet"
    />

    <Analytics />
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var KEY = 'ysc-lang';
        var CHOSEN = 'ysc-lang-chosen';
        var ASKED = 'ysc-lang-asked';

        function store(k, v) {
          try {
            if (v === undefined) return localStorage.getItem(k);
            localStorage.setItem(k, v);
          } catch (e) {}
          return null;
        }

        function current() {
          return root.getAttribute('data-lang') === 'es' ? 'es' : 'en';
        }

        function withLang(href, lang) {
          var u;
          try {
            u = new URL(href, location.href);
          } catch (e) {
            return href;
          }
          if (u.origin !== location.origin) return href;
          if (/\.[a-z0-9]{2,5}$/i.test(u.pathname)) return href;
          if (lang === 'es') u.searchParams.set('lang', 'es');
          else u.searchParams.delete('lang');
          return u.pathname + u.search + u.hash;
        }

        function syncUrl(lang) {
          var next = withLang(location.href, lang);
          var now = location.pathname + location.search + location.hash;
          if (next !== now) history.replaceState(history.state, '', next);
        }

        function rewriteLinks(lang) {
          var links = document.querySelectorAll('a[href]');
          for (var i = 0; i < links.length; i++) {
            var a = links[i];
            var href = a.getAttribute('href');
            if (!href || href.charAt(0) === '#' || a.target === '_blank') continue;
            var next = withLang(href, lang);
            if (next !== href) a.setAttribute('href', next);
          }
        }

        function markButtons(lang) {
          var btns = document.querySelectorAll('.lang-switch [data-lang-btn]');
          for (var i = 0; i < btns.length; i++) {
            var on = btns[i].getAttribute('data-lang-btn') === lang;
            btns[i].classList.toggle('is-on', on);
            btns[i].setAttribute('aria-pressed', on ? 'true' : 'false');
          }
        }

        function sync() {
          var lang = current();
          syncUrl(lang);
          rewriteLinks(lang);
          markButtons(lang);
        }

        document.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('.lang-switch button')) store(CHOSEN, '1');
        });

        new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-lang'] });
        sync();

        function askSpanish() {
          if (current() === 'es' || store(CHOSEN) || store(ASKED)) return;
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          var spanish = false;
          for (var i = 0; i < langs.length; i++) if (/^es\b/i.test(langs[i])) spanish = true;
          if (!spanish) return;

          var box = document.createElement('div');
          box.className = 'lang-prompt';
          box.setAttribute('role', 'status');
          box.setAttribute('aria-live', 'polite');
          box.setAttribute('lang', 'es');
          box.innerHTML =
            '<p class="lang-prompt-title">¿Ver este sitio en español?</p>' +
            '<p class="lang-prompt-sub">This site is in English. We can switch it for you.</p>' +
            '<div class="lang-prompt-actions">' +
            '<button type="button" class="lang-prompt-yes">Sí, en español</button>' +
            '<button type="button" class="lang-prompt-no">No, gracias</button>' +
            '</div>';
          document.body.appendChild(box);

          var timer = setTimeout(close, 20000);
          function close() {
            clearTimeout(timer);
            store(ASKED, '1');
            box.remove();
          }
          box.querySelector('.lang-prompt-no').addEventListener('click', close);
          box.querySelector('.lang-prompt-yes').addEventListener('click', function () {
            var btn = document.querySelector('.lang-switch [data-lang-btn="es"]');
            if (btn) btn.click();
            else {
              store(KEY, 'es');
              store(CHOSEN, '1');
              root.setAttribute('data-lang', 'es');
              root.lang = 'es';
            }
            close();
          });
        }

        setTimeout(askSpanish, 1400);
      })();
    </script>
  </body>
</html>
