---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  jsonLdExtra?: object[];
}

const {
  title = "YSC — Francisco Espindola · Full Stack Engineer",
  description = "YSC is the studio of Francisco Espindola — a Full Stack Engineer building premium digital products end to end, from pixel-perfect interfaces to scalable system architecture.",
  image = "/YSC/logo+text.png",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  jsonLdExtra = [],
  imageWidth = 1920,
  imageHeight = 819,
  imageAlt = "YSC — Francisco Espindola",
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.href);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = new URL(image, siteURL);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "YSC",
      description,
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": `${siteURL}#person`,
      name: "Francisco Espindola",
      alternateName: "frysccou",
      url: siteURL,
      image: ogImage,
      jobTitle: "Full Stack Engineer",
      worksFor: { "@type": "Organization", name: "YSC" },
      address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
      sameAs: [
        "https://github.com/esspindola",
        "https://www.linkedin.com/in/espindola-francisco",
        "https://instagram.com/fryscco_",
      ],
    },
  ],
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('ysc-theme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
          if (localStorage.getItem('ysc-lang') === 'es') {
            document.documentElement.setAttribute('data-lang', 'es');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Espindola" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#0a0b0a" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YSC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@frysccou" />
    <meta name="twitter:creator" content="@frysccou" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" type="image/x-icon" href="/YSC/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/YSC/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/YSC/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/YSC/favicons/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/YSC/favicons/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/YSC/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/YSC/favicons/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Doto:wght@500..900&family=Martian+Mono:wght@300..600&display=swap"
      rel="stylesheet"
    />

    <script defer src="https://va.vercel-scripts.com/v1/analytics"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
