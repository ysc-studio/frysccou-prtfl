---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Paragraph { en: string; es: string; }
interface Section {
  num: string;
  titleEn: string;
  titleEs: string;
  paragraphs?: Paragraph[];
  bullets?: Paragraph[];
}
interface OverviewRow {
  labelEn: string;
  labelEs: string;
  valueEn: string;
  valueEs?: string;
  href?: string;
}

interface Props {
  num: string;
  categoryEn: string;
  categoryEs: string;
  title: string;
  taglineEn: string;
  taglineEs: string;
  introEn: string;
  introEs: string;
  domain?: string;
  domainUrl?: string;
  archived?: boolean;
  heroImage: ImageMetadata;
  heroAlt: string;
  overview: OverviewRow[];
  sections: Section[];
  websiteUrl?: string;
  websiteLabel?: string;
  repoUrl?: string;
  repoLabel?: string;
}

const {
  num, categoryEn, categoryEs, title, taglineEn, taglineEs, introEn, introEs,
  domain, domainUrl, archived = false, heroImage, heroAlt, overview, sections,
  websiteUrl, websiteLabel, repoUrl, repoLabel,
} = Astro.props as Props;
---

<Layout title={`${title} — Case Study · Francisco Espindola`} description={taglineEn}>
<div style="min-height:100vh;background:var(--bg);color:var(--fg);transition:background .35s,color .35s;overflow-x:clip">

  <header style="position:sticky;top:0;z-index:30;background:color-mix(in oklab,var(--bg) 78%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)">
    <div style="position:relative;max-width:1000px;margin:0 auto;padding:12px clamp(18px,4vw,40px);display:flex;align-items:center;justify-content:space-between;gap:14px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.02em">
      <a href="/" style="display:flex;align-items:center;text-decoration:none;color:var(--fg)">
        <img src="/YSC/logo+text.png" alt="YSC Studio" style="height:38px;width:auto;display:block" />
      </a>
      <button id="mobile-menu-btn" type="button" aria-label="Menu" aria-expanded="false" style="all:unset;cursor:pointer;display:none;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--line);border-radius:7px;color:var(--mute);font-size:15px">☰</button>
      <nav id="site-nav" style="display:flex;align-items:center;gap:clamp(10px,2.4vw,24px);flex-wrap:wrap;justify-content:flex-end">
        <a href="/#work" style="text-decoration:none;color:var(--mute)">./<span data-en="">work</span><span data-es="">proyectos</span></a>
        <a href="/resume" style="text-decoration:none;color:var(--mute)">./resume</a>
        <a href="/" style="text-decoration:none;color:var(--mute)">cd ~ ↑</a>
        <div style="display:flex;align-items:center;border:1px solid var(--line);border-radius:6px;overflow:hidden">
          <button id="lang-en-btn" type="button" style="all:unset;cursor:pointer;padding:6px 9px">EN</button>
          <button id="lang-es-btn" type="button" style="all:unset;cursor:pointer;padding:6px 9px">ES</button>
        </div>
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="hover-fg" style="all:unset;cursor:pointer;padding:6px 9px;border:1px solid var(--line);border-radius:6px;color:var(--mute)">◐ dark</button>
      </nav>
    </div>
  </header>

  <main style="max-width:1000px;margin:0 auto;padding:0 clamp(18px,4vw,40px)">

    <section style="padding:clamp(36px,6vw,64px) 0 clamp(28px,4vw,40px)">
      <a href="/#work" style="display:inline-flex;align-items:center;gap:8px;margin-bottom:28px;color:var(--mute);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px"><span style="color:var(--acc)">$</span> cd ../work <span data-en="">(back to work)</span><span data-es="">(volver a proyectos)</span> ↑</a>

      <div data-reveal="" style="display:flex;align-items:center;gap:14px;margin-bottom:18px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--mute)">
        <span style="color:var(--acc)">case study / {num}</span>
        <span style="flex:1;height:1px;background:var(--line)"></span>
        {archived ? (
          <span style="display:flex;align-items:center;gap:7px;text-transform:none"><span style="width:6px;height:6px;border-radius:50%;border:1.5px solid var(--mute)"></span><span data-en="">archived</span><span data-es="">archivado</span></span>
        ) : (
          <span style="display:flex;align-items:center;gap:7px;text-transform:none"><span style="width:6px;height:6px;border-radius:50%;background:var(--acc);animation:pulse 2s infinite"></span><span data-en="">live</span><span data-es="">en producción</span></span>
        )}
      </div>

      <h1 data-reveal="" style="margin:0 0 14px;font-size:clamp(38px,6.5vw,76px);line-height:1;font-weight:600;letter-spacing:-.035em">{title}</h1>
      <p data-reveal="" style="margin:0 0 20px;font-size:clamp(18px,2.4vw,26px);line-height:1.3;color:var(--mute);max-width:36ch"><span data-en="">{taglineEn}</span><span data-es="">{taglineEs}</span></p>

      <div data-reveal="" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:28px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--mute)">
        <span style="padding:5px 10px;border-radius:5px;border:1px solid var(--line)"><span data-en="">{categoryEn}</span><span data-es="">{categoryEs}</span></span>
        {domain && (
          domainUrl ? (
            <a href={domainUrl} target="_blank" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--acc)"><span style="width:6px;height:6px;border-radius:50%;background:var(--acc)"></span>{domain} ↗</a>
          ) : (
            <span style="display:flex;align-items:center;gap:8px;text-transform:none"><span style="width:6px;height:6px;border-radius:50%;border:1.5px solid var(--mute)"></span>{domain}</span>
          )
        )}
      </div>

      <div data-reveal="" style="position:relative;aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:var(--card);border:1px solid var(--line);margin-bottom:28px">
        <Image src={heroImage} alt={heroAlt} width={1000} height={625} style="width:100%;height:100%;object-fit:cover;display:block" />
      </div>

      <p data-reveal="" style="margin:0;font-size:18px;line-height:1.6;color:var(--mute);max-width:70ch;text-wrap:pretty"><span data-en="">{introEn}</span><span data-es="">{introEs}</span></p>
    </section>

    <section style="padding-bottom:clamp(48px,7vw,72px)">
      <div data-reveal="" style="border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden">
        <div style="display:flex;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--line);font-family:'Martian Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--mute)"><span>overview.json</span><span>JSON</span></div>
        <div style="padding:16px 0;font-family:'Martian Mono',monospace;font-size:clamp(12px,1.3vw,14px);line-height:2;color:var(--mute)">
          {overview.map((row, i) => (
            <div class="hover-line" style="display:flex;gap:16px;padding:0 18px">
              <span style="flex:none;width:22px;text-align:right;opacity:.5">{i + 1}</span>
              <span style="padding-left:2ch;text-wrap:pretty">
                <span style="color:var(--fg)">"<span data-en="">{row.labelEn}</span><span data-es="">{row.labelEs}</span>"</span>: {row.href ? (
                  <a href={row.href} target="_blank" style="color:var(--acc);text-decoration:none">"{row.valueEn}" ↗</a>
                ) : (
                  <span style="color:var(--acc)">"<span data-en="">{row.valueEn}</span><span data-es="">{row.valueEs ?? row.valueEn}</span>"</span>
                )}{i < overview.length - 1 ? "," : ""}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {sections.map((s) => (
      <section style="padding-bottom:clamp(48px,7vw,72px)">
        <div data-reveal="" style="display:flex;align-items:center;gap:14px;margin-bottom:18px;font-family:'Martian Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--mute)">
          <span style="color:var(--acc)">{s.num}</span>
          <span><span data-en="">{s.titleEn}</span><span data-es="">{s.titleEs}</span></span>
          <span style="flex:1;height:1px;background:var(--line)"></span>
        </div>
        {s.paragraphs && (
          <div data-reveal="" style="display:flex;flex-direction:column;gap:16px;font-size:17px;line-height:1.65;color:var(--mute);max-width:72ch;text-wrap:pretty">
            {s.paragraphs.map((p) => (
              <p style="margin:0"><span data-en="">{p.en}</span><span data-es="">{p.es}</span></p>
            ))}
          </div>
        )}
        {s.bullets && (
          <ul data-reveal="" style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.5;max-width:72ch">
            {s.bullets.map((b) => (
              <li style="display:flex;align-items:baseline;gap:10px"><span style="font-family:'Martian Mono',monospace;font-size:13px;color:var(--acc)">-</span><span><span data-en="">{b.en}</span><span data-es="">{b.es}</span></span></li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <section style="padding-bottom:clamp(72px,10vw,96px)">
      <div data-reveal="" style="border:1px solid var(--line);border-radius:20px;background:var(--card);padding:clamp(28px,5vw,48px);display:flex;flex-direction:column;gap:24px">
        <h2 style="margin:0;font-size:clamp(28px,4vw,40px);line-height:1.05;font-weight:600;letter-spacing:-.03em"><span data-en="">Explore the project</span><span data-es="">Explorar el proyecto</span></h2>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          {websiteUrl && (
            <a href={websiteUrl} target="_blank" class="hover-bright" style="display:inline-flex;align-items:center;gap:10px;padding:15px 22px;border-radius:10px;background:var(--acc);color:var(--on-acc);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;text-transform:uppercase"><span data-en="">{websiteLabel ?? "Official website"}</span><span data-es="">{websiteLabel ?? "Sitio oficial"}</span> ↗</a>
          )}
          {repoUrl && (
            <a href={repoUrl} target="_blank" style="display:inline-flex;align-items:center;gap:10px;padding:15px 22px;border-radius:10px;border:1px solid var(--line);background:var(--bg);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;text-transform:uppercase"><span data-en="">{repoLabel ?? "Source code"}</span><span data-es="">{repoLabel ?? "Código fuente"}</span> ↗</a>
          )}
          <a href="/#work" style="display:inline-flex;align-items:center;gap:10px;padding:15px 22px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--mute);text-decoration:none;font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;text-transform:uppercase"><span data-en="">More work</span><span data-es="">Más proyectos</span> →</a>
        </div>
      </div>
    </section>

  </main>

  <footer style="border-top:1px solid var(--line)">
    <div style="max-width:1000px;margin:0 auto;padding:28px clamp(18px,4vw,40px) 40px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:16px;font-family:'Martian Mono',monospace;font-size:11px;color:var(--mute)">
      <span>© 2026 Francisco Espindola</span>
      <span>Buenos Aires, Argentina</span>
      <a href="/" style="text-decoration:none;color:var(--mute)">cd ~ ↑</a>
    </div>
  </footer>

</div>
</Layout>

<style>
  .hover-fg:hover { color: var(--fg); }
  .hover-bright:hover { color: var(--on-acc); filter: brightness(1.08); }
  .hover-line:hover { background: color-mix(in oklab, var(--acc) 7%, transparent); }

  @media (max-width: 640px) {
    #mobile-menu-btn { display: flex !important; }
    #site-nav { display: none !important; }
    #site-nav.is-open {
      display: flex !important;
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch !important;
      gap: 2px !important;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 6px clamp(18px,4vw,40px) 18px;
      box-shadow: 0 16px 32px rgba(0,0,0,.25);
    }
    #site-nav.is-open > a { padding: 13px 2px; border-bottom: 1px solid var(--line); text-transform: none; font-size: 14px; }
    #site-nav.is-open > div, #site-nav.is-open > button { align-self: flex-start; margin-top: 10px; }
  }
</style>

<script>
  const THEME_KEY = 'ysc-theme', LANG_KEY = 'ysc-lang';
  const root = document.documentElement;
  let theme = localStorage.getItem(THEME_KEY) || 'dark';
  let lang = localStorage.getItem(LANG_KEY) || 'en';

  function apply() {
    root.dataset.theme = theme; root.dataset.lang = lang; root.lang = lang;
    try { localStorage.setItem(THEME_KEY, theme); localStorage.setItem(LANG_KEY, lang); } catch (e) {}
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) themeBtn.textContent = theme === 'dark' ? '◐ dark' : '◑ light';
    const enBtn = document.getElementById('lang-en-btn'), esBtn = document.getElementById('lang-es-btn');
    if (enBtn) { (enBtn as HTMLElement).style.background = lang === 'en' ? 'var(--fg)' : 'transparent'; (enBtn as HTMLElement).style.color = lang === 'en' ? 'var(--bg)' : 'var(--mute)'; }
    if (esBtn) { (esBtn as HTMLElement).style.background = lang === 'es' ? 'var(--fg)' : 'transparent'; (esBtn as HTMLElement).style.color = lang === 'es' ? 'var(--bg)' : 'var(--mute)'; }
  }
  apply();

  document.getElementById('lang-en-btn')?.addEventListener('click', () => { lang = 'en'; apply(); });
  document.getElementById('lang-es-btn')?.addEventListener('click', () => { lang = 'es'; apply(); });
  document.getElementById('theme-toggle')?.addEventListener('click', () => { theme = theme === 'dark' ? 'light' : 'dark'; apply(); });

  (function mobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    function toggle() {
      const isOpen = nav!.classList.toggle('is-open');
      btn!.textContent = isOpen ? '✕' : '☰';
      btn!.setAttribute('aria-expanded', String(isOpen));
    }
    btn.addEventListener('click', toggle);
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      if (nav!.classList.contains('is-open')) toggle();
    }));
  })();

  (function reveal() {
    const els = document.querySelectorAll('[data-reveal]');
    const io = new IntersectionObserver((es) => es.forEach((en) => {
      if (en.isIntersecting) { (en.target as HTMLElement).style.opacity = '1'; (en.target as HTMLElement).style.transform = 'none'; io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => {
      const r = el.getBoundingClientRect(); if (r.top < innerHeight) return;
      (el as HTMLElement).style.opacity = '0'; (el as HTMLElement).style.transform = 'translateY(24px)';
      (el as HTMLElement).style.transition = 'opacity .8s ease, transform .9s cubic-bezier(.2,.7,.2,1)';
      io.observe(el);
    });
  })();
</script>
